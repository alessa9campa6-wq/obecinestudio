-async def create_session(user_id: str) -> str:
-    token = secrets.token_urlsafe(32)
-    await db.user_sessions.insert_one({"session_token": token, "user_id": user_id, "expires_at": now() + timedelta(days=7), "created_at": now()})
-    return token
